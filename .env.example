# Copy to .env for local overrides. Every value has a sensible default; no API keys are required.

# --- Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
# Only needed when the frontend is hosted on a different origin than the API
CORS_ALLOWED_ORIGINS=http://localhost:5174
API_RATE_LIMIT=120/min

# --- Cache (optional). Without it an in-process cache is used; set this for multiple workers.
# REDIS_URL=redis://localhost:6379/0

# --- Providers (keyless public endpoints by default)
HTTP_USER_AGENT=weather-aware-truck-routing/1.0 (contact: you@example.com)
OSRM_URL=https://router.project-osrm.org
PHOTON_URL=https://photon.komoot.io
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# --- Domain tuning
TRUCK_MAX_SPEED_MPH=65
WEATHER_CACHE_TTL_S=1800
MAX_DEPARTURE_DAYS_AHEAD=7

# --- Frontend (build time). Leave empty when Django serves the built app (same origin).
VITE_API_URL=
